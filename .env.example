# Email configuration
EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_app_password_here
EMAIL_RECIPIENT=your_email@gmail.com

# Optional: customize location (defaults to Newark, NJ)
WEATHER_CITY=Newark
WEATHER_STATE=NJ
WEATHER_LAT=40.7282
WEATHER_LON=-74.1769

# Optional: customize send time display
TIMEZONE=America/New_York

# --- Trading Prep Agent ---
# Polygon.io Stocks Starter plan API key
POLYGON_API_KEY=

# Financial Modeling Prep API key (free tier) — used for VIX quote
FMP_API_KEY=

# Anthropic API key
ANTHROPIC_API_KEY=

# Supabase project URL and service role key (server-side only, never exposed to client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
