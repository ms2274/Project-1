# -------------------------------------------------------
# Resend  — https://resend.com/api-keys
# -------------------------------------------------------

# Your Resend API key
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx

# The "from" address (must be a domain you've verified in Resend)
# During testing you can use: onboarding@resend.dev  (sends to your own email only)
RESEND_FROM_EMAIL=WSJ Digest <digest@yourdomain.com>

# Who receives the digest
EMAIL_RECIPIENT=you@example.com


# -------------------------------------------------------
# Trigger.dev  — https://app.trigger.dev
# -------------------------------------------------------

# Your Trigger.dev secret key (Project > API Keys in the dashboard)
TRIGGER_SECRET_KEY=tr_dev_xxxxxxxxxxxxxxxxxxxx


# -------------------------------------------------------
# WSJ RSS feeds (optional overrides — defaults are shown)
# -------------------------------------------------------

# WSJ_MACRO_FEED=https://feeds.content.dowjones.io/public/rss/WSJ_Economy
# WSJ_BUSINESS_FEED=https://feeds.content.dowjones.io/public/rss/WSJ_US_Business
# WSJ_OPINION_FEED=https://feeds.content.dowjones.io/public/rss/WSJopinion


# -------------------------------------------------------
# Weather Email  (weather_email.py — Gmail SMTP)
# -------------------------------------------------------

EMAIL_SENDER=your_email@gmail.com
EMAIL_PASSWORD=your_gmail_app_password
WEATHER_CITY=Newark
WEATHER_STATE=NJ
WEATHER_LAT=40.7282
WEATHER_LON=-74.1769
TIMEZONE=America/New_York
