# -------------------------------------------------------
# Shared email credentials (used by both scripts)
# -------------------------------------------------------

# Gmail address that sends the emails
EMAIL_SENDER=your_email@gmail.com

# Gmail App Password — NOT your regular Gmail password.
# Generate one at: https://myaccount.google.com/apppasswords
EMAIL_PASSWORD=your_app_password_here

# Address that receives the emails (defaults to EMAIL_SENDER if blank)
EMAIL_RECIPIENT=your_email@gmail.com


# -------------------------------------------------------
# WSJ Daily Digest  (wsj_digest.py)
# -------------------------------------------------------

# Optional: override the RSS feed URLs if WSJ changes them.
# The defaults below are used when these are left blank or omitted.

# WSJ_MACRO_FEED=https://feeds.content.dowjones.io/public/rss/WSJ_Economy
# WSJ_BUSINESS_FEED=https://feeds.content.dowjones.io/public/rss/WSJ_US_Business
# WSJ_OPINION_FEED=https://feeds.content.dowjones.io/public/rss/WSJopinion


# -------------------------------------------------------
# Weather Email  (weather_email.py)
# -------------------------------------------------------

WEATHER_CITY=Newark
WEATHER_STATE=NJ
WEATHER_LAT=40.7282
WEATHER_LON=-74.1769
TIMEZONE=America/New_York
